{
  "name": "summit-calendar",
  "version": "1.0.0",
  "description": "Summit Auto Body Industry - Calendar Tracking for Executives",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create summit-calendar-db",
    "db:init": "wrangler d1 execute summit-calendar-db --file=./schema.sql",
    "db:init-local": "wrangler d1 execute summit-calendar-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.78.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/assets": "^3.0.5"
  }
}
